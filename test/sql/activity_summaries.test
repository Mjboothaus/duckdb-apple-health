# name: test/sql/activity_summaries.test
# description: apple_health_activity_summaries table function
# group: [apple_health]

require apple_health

query IIII
SELECT date_components,
       apple_move_minutes,
       apple_move_time,
       active_energy_burned
FROM apple_health_activity_summaries('test/data/export.xml')
ORDER BY date_components;

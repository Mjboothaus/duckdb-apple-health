# name: test/sql/activity_summaries.test
# description: healthkit_activity_summaries table function
# group: [healthkit_export]

require healthkit_export

query IIII
SELECT date_components,
       apple_move_minutes,
       apple_move_time,
       active_energy_burned
FROM healthkit_activity_summaries('test/data/export.xml')
ORDER BY date_components;
